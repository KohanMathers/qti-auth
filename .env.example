# Copy to .env and fill in the values your config references. An empty value is allowed for settings whose feature is disabled.
# Generate keys and passwords with: openssl rand -base64 32

# Postgres administrator, used by the postgres container and qtiauth db provision. Required by deploy/compose.yaml.
POSTGRES_PASSWORD=

# Postgres role passwords, one per service schema (database.roles)
DB_IDENTITY_PASSWORD=
DB_NOTIFY_PASSWORD=
DB_OIDC_PASSWORD=
DB_SAFETY_PASSWORD=
DB_SUPPORT_PASSWORD=
DB_GAMES_PASSWORD=

# NATS password, if NATS requires credentials (bus.user)
NATS_PASSWORD=

# Key for hashing user IDs in logs, the same on every service (observability.logs.user_id_hash_key)
LOG_USER_ID_HASH_KEY=

# Encrypts TOTP secrets and other application secrets at rest (identity)
APP_ENCRYPTION_KEY=

# Envelope-encrypts signing keys generated by services (gateway identity tokens, oidc)
KEY_ENCRYPTION_KEY=

# Encrypts backups (backup profile). Backups can't be restored without it, so keep a copy outside the stack.
BACKUP_ENCRYPTION_KEY=

# Steam publisher Web API key (features.games.steam)
STEAM_PUBLISHER_KEY=

# Social sign-in (features.auth.social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
