# Copy to .env and fill in the values your config references. An empty value is allowed for settings whose feature is disabled.
# Generate keys and passwords with: openssl rand -base64 32

# Postgres administrator, used by the postgres container and qtiauth db provision. Required by deploy/compose.yaml.
POSTGRES_PASSWORD=

# Postgres role passwords, one per service schema (database.roles) and the audit log role (database.audit)
DB_IDENTITY_PASSWORD=
DB_NOTIFY_PASSWORD=
DB_OIDC_PASSWORD=
DB_SAFETY_PASSWORD=
DB_SUPPORT_PASSWORD=
DB_GAMES_PASSWORD=
DB_AUDIT_PASSWORD=

# NATS password, if NATS requires credentials (bus.user)
NATS_PASSWORD=

# Valkey password, if Valkey requires one (valkey.password)
VALKEY_PASSWORD=

# Key for hashing user IDs in logs, the same on every service (observability.logs.user_id_hash_key)
LOG_USER_ID_HASH_KEY=

# SMTP password, if the SMTP server requires one (email.smtp.user)
SMTP_PASSWORD=

# Encrypts TOTP secrets and other application secrets at rest (identity)
APP_ENCRYPTION_KEY=

# Envelope-encrypts signing keys generated by services (gateway identity tokens, oidc). Required: the gateway won't start without it.
KEY_ENCRYPTION_KEY=

# Encrypts backups (backup profile). Backups can't be restored without it, so keep a copy outside the stack.
BACKUP_ENCRYPTION_KEY=

# Object storage (storage profile / storage section). Use the same values as MINIO_ROOT_* for the bundled MinIO.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Bundled MinIO (storage profile). MINIO_ROOT_USER must be at least 3 characters and MINIO_ROOT_PASSWORD at least 8.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Bundled Grafana (observability profile). Used only for the built-in admin account.
GRAFANA_ADMIN_PASSWORD=

# Bundled Caddy (edge profile). Space-separated list of hosts to serve, and an ACME contact address for Let's Encrypt renewal notices.
EDGE_HOSTS=
EDGE_ACME_EMAIL=

# Steam publisher Web API key (features.games.steam)
STEAM_PUBLISHER_KEY=

# Social sign-in (features.auth.social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
