{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qtiauth:event:qtiauth.safety.csea.enforced.v1",
  "title": "CSEA protective action",
  "description": "A one-click lock or content-removal request from a CSEA case. Never delivered to webhooks. Identity applies the lock. Case content is never included.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "action_id", "action", "rule_id", "target"],
  "properties": {
    "report_id": { "description": "The CSEA report.", "type": "string", "format": "uuid" },
    "action_id": { "description": "The protective action.", "type": "string", "format": "uuid" },
    "action": {
      "description": "lock or remove_content.",
      "enum": ["lock", "remove_content"]
    },
    "rule_id": {
      "description": "Configured rule used for the statement. Must not name CSEA.",
      "type": "string",
      "minLength": 1
    },
    "target": {
      "description": "What the protective action applies to.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "description": "target type.", "enum": ["user", "content"] },
        "id": { "description": "target id.", "type": "string", "minLength": 1 },
        "user_id": {
          "description": "The account to lock, when known.",
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "expires_at": {
      "description": "When a lock expires.",
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
