{
  "uid": "qtiauth-auth",
  "title": "QTIAuth — Auth and sessions",
  "tags": ["qtiauth", "identity"],
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Sign-ins by method and result",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (method, result) (rate(qtiauth_auth_sign_ins_total[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Signups by method and age band",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (method, age_band) (rate(qtiauth_auth_signups_total[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Magic links sent, used and expired",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(qtiauth_auth_magic_links_total[5m]))" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Password failures and breach checks",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(qtiauth_auth_password_failures_total[5m]))",
          "legendFormat": "failures"
        },
        { "refId": "B", "expr": "sum by (result) (rate(qtiauth_auth_breach_checks_total[5m]))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "2FA challenges, passkey registrations, step-up",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (factor, result) (rate(qtiauth_auth_2fa_challenges_total[5m]))"
        },
        {
          "refId": "B",
          "expr": "sum(rate(qtiauth_auth_passkey_registrations_total[5m]))",
          "legendFormat": "passkey regs"
        },
        {
          "refId": "C",
          "expr": "sum by (result) (rate(qtiauth_auth_step_up_total[5m]))",
          "legendFormat": "step-up"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CAPTCHA shown / solved / failed",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(qtiauth_auth_captcha_total[5m]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sessions created and revoked",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(qtiauth_sessions_created_total[5m]))",
          "legendFormat": "created"
        },
        { "refId": "B", "expr": "sum by (reason) (rate(qtiauth_sessions_revoked_total[5m]))" },
        {
          "refId": "C",
          "expr": "sum(rate(qtiauth_session_bindings_created_total[5m]))",
          "legendFormat": "bindings"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Active sessions and accounts",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(qtiauth_sessions_active)", "legendFormat": "sessions" },
        { "refId": "B", "expr": "sum by (state) (qtiauth_accounts)" },
        {
          "refId": "C",
          "expr": "sum(qtiauth_legal_acceptance_pending)",
          "legendFormat": "legal pending"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Text filter decisions and username claims",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (rule) (rate(qtiauth_filter_decisions_total[5m]))" },
        { "refId": "B", "expr": "sum by (result) (rate(qtiauth_usernames_claimed_total[5m]))" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Admin actions, deletions, exports, audit",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (action) (rate(qtiauth_admin_user_actions_total[15m]))" },
        { "refId": "B", "expr": "sum by (outcome) (rate(qtiauth_account_deletions_total[15m]))" },
        { "refId": "C", "expr": "sum by (result) (rate(qtiauth_data_exports_total[15m]))" },
        {
          "refId": "D",
          "expr": "sum(rate(qtiauth_audit_recorded_total[1m]))",
          "legendFormat": "audit"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Parental consent, family sessions, graduation, age bands",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(qtiauth_parental_consent_total[15m]))" },
        { "refId": "B", "expr": "sum by (event) (rate(qtiauth_family_sessions_total[15m]))" },
        { "refId": "C", "expr": "sum by (outcome) (rate(qtiauth_parental_graduation_total[15m]))" },
        { "refId": "D", "expr": "sum by (from, to) (rate(qtiauth_age_band_changes_total[15m]))" }
      ]
    }
  ]
}
