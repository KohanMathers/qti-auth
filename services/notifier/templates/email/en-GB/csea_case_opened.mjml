<mjml lang="en-GB">
  <mj-head>
    <mj-title>A CSEA case needs attention</mj-title>
    <mj-preview>A case has been opened. This message never includes case content.</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section padding="32px 16px 0">
      <mj-column background-color="#ffffff" border-radius="8px" padding="24px">
        <mj-text font-size="22px" line-height="30px" font-weight="600">
          A CSEA case needs attention
        </mj-text>
        <mj-text>
          A case has been opened and needs a holder of the CSEA access permission to review it and,
          if required, submit it through the NCA portal.
        </mj-text>
        <mj-button
          href="{{ link }}"
          background-color="{{ brand.primary_color }}"
          color="#ffffff"
          font-size="16px"
          font-weight="600"
          border-radius="6px"
          align="left"
        >
          Open the case
        </mj-button>
        <mj-text font-size="14px" color="#6b7280">
          This message never includes case content.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#6b7280" align="center">
          {{ brand.company_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
