<mjml lang="en-GB">
  <mj-head>
    <mj-title>Your {{ brand.product_name }} data export is attached</mj-title>
    <mj-preview>Your data export is attached as {{ filename }}</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section padding="32px 16px 0">
      <mj-column background-color="#ffffff" border-radius="8px" padding="24px">
        <mj-text font-size="22px" line-height="30px" font-weight="600">
          Your {{ brand.product_name }} data export
        </mj-text>
        <mj-text> A copy of your data is attached as {{ filename }}. </mj-text>
        <mj-text font-size="14px" line-height="20px" color="#4b5563">
          If you didn't ask for an export, contact {{ brand.support_email }}.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#6b7280" align="center">
          Need help? Contact {{ brand.support_email }}.<br />
          {{ brand.company_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
