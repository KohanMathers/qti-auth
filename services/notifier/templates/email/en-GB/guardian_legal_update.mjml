<mjml lang="en-GB">
  <mj-head>
    <mj-title>A legal document changed for a child on {{ brand.product_name }}</mj-title>
    <mj-preview>{{ summary }}</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section padding="32px 16px 0">
      <mj-column background-color="#ffffff" border-radius="8px" padding="24px">
        <mj-text font-size="22px" line-height="30px" font-weight="600">
          A legal document changed
        </mj-text>
        <mj-text>{{ summary }}</mj-text>
        <mj-button
          href="{{ link }}"
          background-color="{{ brand.primary_color }}"
          color="#ffffff"
          font-size="16px"
          font-weight="600"
          border-radius="6px"
          align="left"
        >
          Read the document
        </mj-button>
        <mj-text>
          If this change needs acceptance, you can do that on the child’s behalf from the family
          dashboard.
        </mj-text>
        <mj-button
          href="{{ family_link }}"
          background-color="#ffffff"
          color="#1f2937"
          font-size="16px"
          font-weight="600"
          border-radius="6px"
          border="1px solid #d1d5db"
          align="left"
        >
          Open family dashboard
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#6b7280" align="center">
          Need help? Contact {{ brand.support_email }}.<br />
          {{ brand.company_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
