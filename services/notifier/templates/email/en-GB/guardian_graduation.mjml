<mjml lang="en-GB">
  <mj-head>
    <mj-title
      >{{ username }} has reached the age where parental controls become optional on
      {{ brand.product_name }}</mj-title
    >
    <mj-preview>Controls stay in place for {{ grace_days }} days</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section padding="32px 16px 0">
      <mj-column background-color="#ffffff" border-radius="8px" padding="24px">
        <mj-text font-size="22px" line-height="30px" font-weight="600">
          Parental controls will become optional
        </mj-text>
        <mj-text>
          {{ username }} has reached the age where parental controls on
          {{ brand.product_name }} become optional in {{ grace_days }} days. Until then you can
          still manage their account. After that they can ask you to remove the parent or guardian
          link.
        </mj-text>
        <mj-button
          href="{{ link }}"
          background-color="{{ brand.primary_color }}"
          color="#ffffff"
          font-size="16px"
          font-weight="600"
          border-radius="6px"
          align="left"
        >
          Open family dashboard
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#6b7280" align="center">
          Need help? Contact {{ brand.support_email }}.<br />
          {{ brand.company_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
