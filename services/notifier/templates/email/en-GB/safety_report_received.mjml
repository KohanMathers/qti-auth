<mjml lang="en-GB">
  <mj-head>
    <mj-title>Report received on {{ product_name }}</mj-title>
    <mj-preview>We have received your report ({{ reference }}) and will look into it.</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section padding="32px 16px 0">
      <mj-column background-color="#ffffff" border-radius="8px" padding="24px">
        <mj-text font-size="22px" line-height="30px" font-weight="600">
          Thanks for the report
        </mj-text>
        <mj-text>
          We have received your report of {{ type }} on {{ product_name }} and a moderator will
          review it.
        </mj-text>
        <mj-text>Your reference is {{ reference }}.</mj-text>
        <mj-text>
          We will not share your identity with the person you reported. You can reply to this email
          if you need to add anything.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#6b7280" align="center">
          Need help? Contact {{ support_email }}.<br />
          {{ brand.company_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
