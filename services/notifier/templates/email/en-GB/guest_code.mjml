<mjml lang="en-GB">
  <mj-head>
    <mj-title>Your support code for {{ brand.product_name }}</mj-title>
    <mj-preview>Your code expires in {{ expires_in_minutes }} minutes.</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-section padding="32px 16px 0">
      <mj-column background-color="#ffffff" border-radius="8px" padding="24px">
        <mj-text font-size="22px" line-height="30px" font-weight="600">Your support code</mj-text>
        <mj-text>
          Use this code to open a ticket. It expires in {{ expires_in_minutes }} minutes.
        </mj-text>
        <mj-text font-size="28px" line-height="36px" font-weight="600" letter-spacing="4px">
          {{ code }}
        </mj-text>
        <mj-text font-size="14px" line-height="20px" color="#4b5563">
          If you didn't ask for a code, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#6b7280" align="center">
          Need help? Contact {{ brand.support_email }}.<br />
          {{ brand.company_name }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
